#!/usr/bin/env python3
"""bullpen: a coordinator and its worker agents, each in its own Rex pane.

Tasks live outside the repo, in $BULLPEN_STATE (default ~/.local/state/bullpen).
Each started task gets a git worktree, a branch and a Rex window running a
worker agent. A Lua watcher (lua/watch.lua, run with `rex do --all`) turns the
workers' program status into news lines typed into the coordinator's pane.
"""

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path(__file__).resolve().parent.parent
PROMPTS = HOME / "prompts"
WATCH_LUA = HOME / "lua" / "watch.lua"
STATE = Path(os.environ.get("BULLPEN_STATE") or Path.home() / ".local/state/bullpen")
REX = os.environ.get("BULLPEN_REX", "rex")
SELF = str(Path(__file__).resolve())

DEFAULT_CONFIG = {
    "prefix": "BP",
    "next": 1,
    "base": None,
    "worker": ["claude", "--permission-mode", "auto"],
    "coordinator_cmd": ["claude", "--permission-mode", "auto"],
    "coordinator": None,  # {"block": ..., "session": ...}
    "workers": "float",   # "float": minimized floating panes in the coordinator's tab; "tabs"
    "gh": None,           # the gh program, if not the one on PATH (BULLPEN_GH wins)
}

TERMINAL = "com.superlogical.terminal.shell"
FLOAT_BOUNDS = [0.4, 0.35, 0.58, 0.62]  # bottom right of the window: x, y, w, h

CLOSED = ("done", "dropped")


class Fail(Exception):
    pass


# ---------- small helpers ----------

def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def run(cmd, cwd=None, check=True, input=None):
    p = subprocess.run(cmd, cwd=cwd, input=input, text=True, capture_output=True)
    if check and p.returncode != 0:
        msg = (p.stderr or p.stdout).strip()
        raise Fail(f"`{' '.join(map(str, cmd))}` failed: {msg}")
    return p


def git(repo, *args, check=True):
    return run(["git", "-C", str(repo), *args], check=check)


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except FileNotFoundError:
        return default


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def safe(name):
    return re.sub(r"[^A-Za-z0-9._-]", "_", name)


def slug(title, n=40):
    s = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return s[:n].rstrip("-") or "task"


def resolve(cmd):
    """Absolute path for the program, so Rex panes don't depend on PATH."""
    exe = shutil.which(cmd[0])
    return [exe or cmd[0], *cmd[1:]]


# ---------- repo, config, tasks ----------

def repo_root(path=None):
    p = run(["git", "-C", str(path or os.getcwd()), "rev-parse", "--path-format=absolute",
             "--git-common-dir"], check=False)
    if p.returncode != 0:
        raise Fail("not in a git repository")
    common = Path(p.stdout.strip())
    return common.parent if common.name == ".git" else common


class Repo:
    def __init__(self, root):
        self.root = Path(root)
        self.dir = STATE / "repos" / safe(str(self.root).strip("/").replace("/", "-"))
        cfg = read_json(self.dir / "config.json", {})
        self.cfg = {**DEFAULT_CONFIG, **cfg}

    def save(self):
        write_json(self.dir / "config.json", self.cfg)

    def gh(self):
        return os.environ.get("BULLPEN_GH") or self.cfg.get("gh") or "gh"

    def base(self):
        if self.cfg.get("base"):
            return self.cfg["base"]
        p = git(self.root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False)
        if p.returncode == 0:
            return p.stdout.strip().split("/", 1)[1]
        return git(self.root, "branch", "--show-current").stdout.strip() or "main"

    def task_path(self, tid):
        return self.dir / "tasks" / f"{tid}.json"

    def task(self, tid):
        tid = self.norm(tid)
        t = read_json(self.task_path(tid))
        if t is None:
            raise Fail(f"no task {tid} in {self.root}")
        return t

    def norm(self, tid):
        tid = str(tid).upper()
        return tid if "-" in tid else f"{self.cfg['prefix']}-{tid}"

    def save_task(self, t):
        t["updated"] = now()
        old = read_json(self.task_path(t["id"])) or {}
        if old.get("status") != t["status"] or not t.get("since"):
            # when it entered its current status; fine-grained so `go --next` can order it
            t["since"] = dt.datetime.now().astimezone().isoformat(timespec="microseconds")
        write_json(self.task_path(t["id"]), t)

    def tasks(self):
        d = self.dir / "tasks"
        out = [read_json(p) for p in d.glob("*.json")] if d.exists() else []
        return sorted(out, key=lambda t: int(t["id"].rsplit("-", 1)[1]))

    def worktree_dir(self, t):
        return self.root.parent / f"{self.root.name}-bullpen" / t["id"]


def index_block(block, repo, role):
    write_json(STATE / "blocks" / f"{safe(block)}.json", {"repo": str(repo.root), "role": role})


def unindex_block(block):
    if block:
        (STATE / "blocks" / f"{safe(block)}.json").unlink(missing_ok=True)


def lookup_block(block):
    entry = read_json(STATE / "blocks" / f"{safe(block)}.json") if block else None
    if not entry:
        return None, None
    return Repo(entry["repo"]), entry["role"]


def find_repo(from_block=None):
    """The repo a command is about: the one owning from_block, else the one we're in,
    else (for key bindings, which run in the Rex server's directory) the bullpen repo
    whose coordinator most recently started."""
    repo, _ = lookup_block(from_block)
    if repo:
        return repo
    try:
        repo = Repo(repo_root())
        if (repo.dir / "config.json").exists():
            return repo
    except Fail:
        pass
    best = None
    for cfg in (STATE / "repos").glob("*/config.json"):
        b = (read_json(cfg) or {}).get("coordinator")
        if not b:
            continue
        idx = STATE / "blocks" / f"{safe(b['block'])}.json"
        entry = read_json(idx)
        if entry and (best is None or idx.stat().st_mtime > best[0]):
            best = (idx.stat().st_mtime, entry["repo"])
    if best:
        return Repo(best[1])
    raise Fail("no bullpen here: run `bullpen up` in a repository first")


# ---------- Rex ----------

def with_state(argv):
    """Panes Rex starts don't inherit our environment: carry bullpen's own settings."""
    env = [f"{k}={os.environ[k]}" for k in ("BULLPEN_STATE", "BULLPEN_GH", "BULLPEN_REX")
           if os.environ.get(k)]
    return ["env", *env, *argv] if env else argv


def rex_run(session, cwd, label, argv, focus=False):
    cmd = [REX, "run", "--json", f"--focus={'true' if focus else 'false'}", "--label", label,
           "-c", str(cwd)]
    if session:
        cmd += ["-s", session]
    p = run([*cmd, "--", *with_state(argv)])
    return json.loads(p.stdout)["block_ids"][0]


def rex_alive(session, block):
    if not block:
        return False
    cmd = [REX, "block", "inspect", block] + (["-s", session] if session else [])
    return run(cmd, check=False).returncode == 0


def rex_type(session, block, text):
    """Type one line into a terminal and press Enter."""
    s = ["-s", session] if session else []
    run([REX, "send", *s, "-b", block, text])
    run([REX, "send-key", *s, "-b", block, "enter"])


def rex_focus(session, block):
    run([REX, "focus", *(["-s", session] if session else []), block])


def rex_api(session, method, args=None, check=True):
    """Call a Rex server API method; -s fills in session_id."""
    cmd = [REX, "api", "call", *(["-s", session] if session else []), method, json.dumps(args or {})]
    p = run(cmd, check=check)
    if p.returncode != 0 or not p.stdout.strip():
        return None
    return json.loads(p.stdout)


def rex_view(session):
    """The session's windows, layers and blocks, or None if Rex can't say."""
    v = rex_api(session, "session.view", check=False)
    return v if v and "windows" in v else None


def find_pane(view, block=None, label=None):
    """(window_id, layer, block_id) of a placed block, by ID, else by label."""
    for w in (view or {}).get("windows", []):
        for layer in w.get("layers", []):
            for b in layer.get("blocks", []):
                if (block and b.get("block_id") == block) or (not block and label and b.get("label") == label):
                    return w["window_id"], layer, b["block_id"]
    return None


def set_layer(session, layer_id, state, focus=False):
    args = {"layer_id": layer_id, "state": state}
    if focus:
        args["focus"] = True
    return rex_api(session, "session.set_layer_state", args, check=False) is not None


def rex_close(session, block):
    if block:
        run([REX, "block", "close", block] + (["-s", session] if session else []), check=False)


def pr_short(url):
    m = re.search(r"/pull/(\d+)", url or "")
    return f"PR #{m.group(1)}" if m else (url or "")


def news(repo, task, event, text):
    """Type one line of news into the coordinator's prompt: `bullpen · <what happened>`."""
    line = "bullpen · " + " ".join(text.split())  # one line: a newline would send it early
    log = repo.dir / "news.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a") as f:
        f.write(f"{now()} {task['id']} {event}: {line}\n")
    c = repo.cfg.get("coordinator")
    if c and rex_alive(c.get("session"), c.get("block")):
        rex_type(c.get("session"), c["block"], line)
    else:
        print(f"bullpen: no live coordinator; news kept in {log}", file=sys.stderr)


def coordinator_label(repo):
    return f"bullpen: {repo.root.name}"


def board_label(repo):
    return f"bullpen: {repo.root.name} board"


def session_for(repo, args=None):
    """The Rex session to work in: --session, else the coordinator's while it exists
    (a Rex restart gives sessions new IDs), else the one we're running in."""
    s = getattr(args, "session", None) if args else None
    c = (repo.cfg.get("coordinator") or {}).get("session")
    if s:
        return s
    if c and (c == os.environ.get("REX_SESSION") or rex_view(c) is not None):
        return c
    return os.environ.get("REX_SESSION") or c


# ---------- commands ----------

def cmd_up(args):
    repo = Repo(repo_root())
    session = session_for(repo, args)
    if not session:
        raise Fail("not inside Rex: pass --session")
    relink(repo, session)
    c = repo.cfg.get("coordinator")
    if args.here:
        block = os.environ.get("REX_BLOCK")
        if not block:
            raise Fail("--here needs REX_BLOCK (run it from the agent's own Rex pane)")
        if c:
            unindex_block(c.get("block"))
        repo.cfg["coordinator"] = {"block": block, "session": session}
        index_block(block, repo, "coordinator")
        print(f"coordinator: this pane ({block}). Run `{SELF} guide` to read the coordinator's guide.")
    elif c and rex_alive(c.get("session"), c.get("block")):
        print(f"coordinator already running: {c['block']}")
    else:
        argv = resolve(repo.cfg["coordinator_cmd"]) + [
            "-n", coordinator_label(repo),
            "--append-system-prompt-file", str(PROMPTS / "coordinator.md"),
            f"You are the bullpen coordinator for {repo.root}. The bullpen CLI is {SELF}. "
            f"Run `{SELF} ls`, then say in one short line that you are ready.",
        ]
        block = rex_run(session, repo.root, coordinator_label(repo), argv, focus=True)
        repo.cfg["coordinator"] = {"block": block, "session": session}
        index_block(block, repo, "coordinator")
        print(f"coordinator started: {block}")
    repo.save()
    if not args.no_board:
        ensure_board(repo, session)
    ensure_watcher(session)


def ensure_board(repo, session):
    """The task board, in a narrow pane to the right of the coordinator."""
    b = repo.cfg.get("board")
    if b and rex_alive(b.get("session"), b.get("block")):
        return
    c = repo.cfg["coordinator"]
    p = run([REX, "split", "--json", "--focus=false", "-s", session, "-b", c["block"],
             "--split=right", "--ratio", "35", "--label", board_label(repo),
             "-c", str(repo.root), "--", *with_state([SELF, "board"])])
    block = json.loads(p.stdout)["block_ids"][0]
    if b:
        unindex_block(b.get("block"))
    repo.cfg["board"] = {"block": block, "session": session}
    index_block(block, repo, "board")
    repo.save()
    print(f"board started: {block}")


def ensure_watcher(session):
    w = read_json(STATE / "watcher.json", {})
    if rex_alive(w.get("session"), w.get("block")):
        return
    argv = [shutil.which(REX) or REX, "do", "--all", str(WATCH_LUA),
            f"bin={SELF}", f"state={STATE}"]
    # Detached: it runs without a tab of its own.
    r = rex_api(session, "session.new_block", {
        "flavor": TERMINAL, "label": "bullpen: watcher",
        "options": {"command": with_state(argv), "cwd": str(Path.home())}})
    block = r["block_id"]
    write_json(STATE / "watcher.json", {"block": block, "session": session})
    print(f"watcher started: {block}")


def cmd_add(args):
    repo = Repo(repo_root())
    brief = Path(args.brief_file).read_text() if args.brief_file else args.brief
    if not brief:
        raise Fail("give the task's brief with --brief or --brief-file")
    tid = f"{repo.cfg['prefix']}-{repo.cfg['next']}"
    repo.cfg["next"] += 1
    repo.save()
    t = {"id": tid, "title": args.title, "status": "todo", "created": now(),
         "base": args.base or repo.base(), "branch": None, "worktree": None,
         "block": None, "session": None, "pr": None, "why": None, "last": None}
    (repo.dir / "briefs").mkdir(parents=True, exist_ok=True)
    (repo.dir / "briefs" / f"{tid}.md").write_text(brief.rstrip() + "\n")
    repo.save_task(t)
    print(tid)


def footer(repo, t):
    return (PROMPTS / "worker-footer.md").read_text().format(
        id=t["id"], title=t["title"], worktree=t["worktree"], branch=t["branch"],
        base=t["base"], bin=SELF)


def cmd_start(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if t["status"] not in ("todo", "stopped"):
        raise Fail(f"{t['id']} is {t['status']}; use `resume` or `tell`")
    session = session_for(repo, args)
    if not session:
        raise Fail("no Rex session: run `bullpen up` first or pass --session")
    if not t["worktree"]:
        base = t["base"]
        start_point = base
        if git(repo.root, "remote", "get-url", "origin", check=False).returncode == 0:
            git(repo.root, "fetch", "-q", "origin", base, check=False)
            if git(repo.root, "rev-parse", "-q", "--verify", f"origin/{base}", check=False).returncode == 0:
                start_point = f"origin/{base}"
        t["branch"] = f"bullpen/{t['id'].lower()}-{slug(t['title'])}"
        wt = repo.worktree_dir(t)
        wt.parent.mkdir(parents=True, exist_ok=True)
        git(repo.root, "worktree", "add", "-q", "--no-track", "-b", t["branch"], str(wt), start_point)
        t["worktree"] = str(wt)
    brief = (repo.dir / "briefs" / f"{t['id']}.md").read_text()
    full = repo.dir / "briefs" / f"{t['id']}.full.md"
    full.write_text(f"# {t['id']}: {t['title']}\n\n{brief}\n{footer(repo, t)}")
    first = f"You are the worker for bullpen task {t['id']}. Read your brief at {full} and follow it."
    launch(repo, t, session, first, resume=False)
    print(f"{t['id']} started in {t['worktree']} (branch {t['branch']}, pane {t['block']})")


def launch(repo, t, session, first, resume):
    argv = resolve(repo.cfg["worker"]) + (["--continue"] if resume else []) + \
        ["-n", f"{t['id']}: {t['title']}", first]
    unindex_block(t.get("block"))
    label = f"bullpen: {t['id']}"
    if repo.cfg.get("workers") == "tabs":
        block = rex_run(session, t["worktree"], label, argv)
    else:
        block = float_pane(repo, session, label, t["worktree"], argv)
    index_block(block, repo, t["id"])
    t.update(block=block, session=session, status="working", why=None, last=None)
    repo.save_task(t)


def float_pane(repo, session, label, cwd, argv):
    """Start argv in a minimized floating pane in the coordinator's window: it shows
    as a capsule at the bottom right until `bullpen go` brings it up."""
    args = {"bounds": FLOAT_BOUNDS, "layout": {"block": {
        "flavor": TERMINAL, "label": label,
        "options": {"command": with_state(argv), "cwd": str(cwd)}}}}
    c = repo.cfg.get("coordinator") or {}
    where = find_pane(rex_view(session), block=c.get("block"))
    if where:
        args["window_id"] = where[0]
    r = rex_api(session, "session.new_layer", args)
    set_layer(session, r["layer_id"], "minimized")
    return r["block_ids"][0]


def relink(repo, session):
    """A Rex restart brings panes back with new block IDs: find bullpen's own again
    by their labels. Panes that are gone are forgotten (a working task is stopped)."""
    view = rex_view(session)
    if view is None:
        return
    known = {}

    def ours(stored):
        """Is a pane recorded in session `stored` one to look for here? Yes if it's
        this session, or if that session no longer exists (a restart renamed it)."""
        if stored in (None, session, view.get("session_id"), view.get("label")):
            return True
        if stored not in known:
            known[stored] = rex_view(stored) is None
        return known[stored]

    for key, label in (("coordinator", coordinator_label(repo)), ("board", board_label(repo))):
        c = repo.cfg.get(key)
        if not c or (c.get("session") == session and find_pane(view, block=c.get("block"))):
            continue
        if find_pane(view, block=c.get("block")):
            c["session"] = session
            continue
        if not ours(c.get("session")):
            continue
        unindex_block(c.get("block"))
        hit = find_pane(view, label=label)
        repo.cfg[key] = {"block": hit[2], "session": session} if hit else None
        if hit:
            index_block(hit[2], repo, key)
            print(f"{key}: found again ({hit[2]})")
    repo.save()
    for t in repo.tasks():
        if t["status"] in CLOSED or not t.get("block") or find_pane(view, block=t["block"]):
            continue
        if not ours(t.get("session")):
            continue
        unindex_block(t["block"])
        hit = find_pane(view, label=f"bullpen: {t['id']}")
        if hit:
            t.update(block=hit[2], session=session)
            index_block(hit[2], repo, t["id"])
            print(f"{t['id']}: found again ({hit[2]})")
        else:
            t["block"] = None
            if t["status"] in ("working", "needs"):
                t.update(status="stopped", why="Its pane was gone")
        repo.save_task(t)


def cmd_resume(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if rex_alive(t["session"], t["block"]):
        raise Fail(f"{t['id']}'s agent is still running; use `tell`")
    if not t["worktree"]:
        raise Fail(f"{t['id']} never started; use `start`")
    msg = args.message or "You were stopped before finishing. Check where you were and carry on with your brief."
    launch(repo, t, session_for(repo, args) or t["session"], msg, resume=True)
    print(f"{t['id']} resumed in pane {t['block']}")


def cmd_tell(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if not rex_alive(t["session"], t["block"]):
        raise Fail(f"{t['id']}'s agent isn't running; use `resume {t['id']} \"...\"`")
    rex_type(t["session"], t["block"], " ".join(args.message))
    if t["status"] in ("needs", "ready"):
        t.update(status="working", why=None, last=None)
        repo.save_task(t)
    print(f"sent to {t['id']}")


def cmd_peek(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if not rex_alive(t["session"], t["block"]):
        raise Fail(f"{t['id']}'s agent isn't running")
    s = ["-s", t["session"]] if t["session"] else []
    out = run([REX, "capture", *s, "-b", t["block"]]).stdout
    lines = [l for l in out.splitlines()]
    while lines and not lines[-1].strip():
        lines.pop()
    print("\n".join(lines[-args.lines:]))


def cmd_ready(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    wt = t["worktree"]
    if not wt:
        raise Fail(f"{t['id']} has no worktree")
    if git(wt, "status", "--porcelain").stdout.strip():
        raise Fail("uncommitted changes: commit (or discard) them, then run ready again")
    summary = Path(args.summary_file).read_text() if args.summary_file else (args.summary or "")
    base_ref = f"origin/{t['base']}" if git(wt, "rev-parse", "-q", "--verify", f"origin/{t['base']}", check=False).returncode == 0 else t["base"]
    ahead = int(git(wt, "rev-list", "--count", f"{base_ref}..HEAD").stdout.strip())
    if ahead == 0:
        t.update(status="ready", why="Nothing to merge (no commits)", summary=summary.strip() or None)
        repo.save_task(t)
        news(repo, t, "ready", f"{t['id']} is ready with nothing to merge: {t['title']}")
        print("no commits: marked ready with nothing to merge")
        return
    git(wt, "push", "-q", "--force-with-lease", "-u", "origin", f"HEAD:refs/heads/{t['branch']}")
    if not t.get("pr"):
        body = (summary.strip() or t["title"]) + f"\n\nBullpen task {t['id']}.\n"
        p = run([repo.gh(), "pr", "create", "--base", t["base"], "--head", t["branch"],
                 "--title", f"{t['title']} ({t['id']})", "--body-file", "-"], cwd=wt, input=body)
        t["pr"] = p.stdout.strip().splitlines()[-1]
    t.update(status="ready", why=None, summary=summary.strip() or t.get("summary"))
    repo.save_task(t)
    news(repo, t, "ready", f"{t['id']} is ready ({ahead} commit{'s' if ahead != 1 else ''}, {pr_short(t['pr'])}): {t['title']}")
    print(f"pushed {t['branch']}; pull request: {t['pr']}")


def remove_worktree(repo, t, force=False):
    if t.get("worktree") and Path(t["worktree"]).exists():
        git(repo.root, "worktree", "remove", *(["--force"] if force else []), t["worktree"])
    if t.get("branch"):
        git(repo.root, "branch", "-D", t["branch"], check=False)


def cmd_accept(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if t["status"] != "ready":
        raise Fail(f"{t['id']} is {t['status']}, not ready")
    if t.get("pr"):
        p = run([repo.gh(), "pr", "merge", t["pr"], "--squash"], cwd=repo.root, check=False)
        if p.returncode != 0:
            raise Fail(f"merge refused: {(p.stderr or p.stdout).strip()}")
        git(repo.root, "push", "-q", "origin", "--delete", t["branch"], check=False)
    rex_close(t["session"], t["block"])
    unindex_block(t["block"])
    remove_worktree(repo, t, force=True)
    t.update(status="done", block=None, worktree=None)
    repo.save_task(t)
    print(f"{t['id']} done" + (f" (merged {t['pr']})" if t.get("pr") else ""))


def cmd_drop(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if t.get("worktree") and Path(t["worktree"]).exists() and not args.force:
        if git(t["worktree"], "status", "--porcelain").stdout.strip():
            raise Fail(f"{t['id']} has uncommitted changes in {t['worktree']}; pass --force to discard them")
    rex_close(t["session"], t["block"])
    unindex_block(t["block"])
    if t.get("pr"):
        run([repo.gh(), "pr", "close", t["pr"]], cwd=repo.root, check=False)
    remove_worktree(repo, t, force=args.force)
    t.update(status="dropped", block=None, worktree=None)
    repo.save_task(t)
    print(f"{t['id']} dropped")


def cmd_ls(args):
    repo = Repo(repo_root())
    tasks = [t for t in repo.tasks() if args.all or t["status"] not in CLOSED]
    if args.json:
        print(json.dumps(tasks, indent=2))
        return
    if not tasks:
        print("no open tasks" + ("" if args.all else " (--all shows finished ones)"))
    for t in tasks:
        extra = t.get("why") or t.get("pr") or ""
        print(f"{t['id']:<7} {t['status']:<8} {t['title']}" + (f"  ({extra})" if extra else ""))


def cmd_show(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if args.json:
        print(json.dumps(t, indent=2))
        return
    for k in ("id", "title", "status", "why", "base", "branch", "worktree", "block", "pr", "summary"):
        if t.get(k):
            print(f"{k:>9}: {t[k]}")
    print(f"    brief: {repo.dir / 'briefs' / (t['id'] + '.md')}")


def cmd_config(args):
    repo = Repo(repo_root())
    if args.prefix:
        if not re.fullmatch(r"[A-Z]{2,5}", args.prefix):
            raise Fail("prefix must be 2 to 5 capital letters")
        repo.cfg["prefix"] = args.prefix
    if args.base:
        repo.cfg["base"] = args.base
    if args.workers:
        repo.cfg["workers"] = args.workers
    repo.save()
    print(json.dumps({"repo": str(repo.root), "state": str(repo.dir), **repo.cfg}, indent=2))


def cmd_guide(args):
    print((PROMPTS / "coordinator.md").read_text())


# ---------- getting around: go, board, keys ----------

def go_target(repo, args):
    """(session, block, name) of the pane `go` should focus."""
    if args.next:
        needs = sorted((t for t in repo.tasks() if t["status"] == "needs" and t.get("block")),
                       key=lambda t: t.get("since") or t.get("updated") or "")
        if not needs:
            raise Fail("nothing needs you")
        blocks = [t["block"] for t in needs]
        here = args.from_block
        t = needs[(blocks.index(here) + 1) % len(needs) if here in blocks else 0]
        return t["session"], t["block"], t["id"]
    if args.id:
        t = repo.task(args.id)
        if not t.get("block"):
            hint = f"`bullpen resume {t['id']}`" if t["status"] == "stopped" else f"it is {t['status']}"
            raise Fail(f"{t['id']} has no pane ({hint})")
        return t["session"], t["block"], t["id"]
    which = "board" if args.board else "coordinator"
    c = repo.cfg.get(which)
    if not c:
        raise Fail(f"no {which}: run `bullpen up`")
    return c.get("session"), c["block"], which


def cmd_go(args):
    repo = find_repo(args.from_block)
    session, block, name = go_target(repo, args)
    if not rex_alive(session, block):
        # after a Rex restart its ID changed (and maybe its session's)
        relink(repo, args.session or os.environ.get("REX_SESSION") or session)
        repo = Repo(repo.root)
        session, block, name = go_target(repo, args)
        if not rex_alive(session, block):
            raise Fail(f"{name}'s pane is gone")
    if args.json:
        print(json.dumps({"session": session, "block": block, "name": name}))
    else:
        show_pane(repo, session, block)


def show_pane(repo, session, block):
    """Focus a pane. A worker's floating pane comes up from its capsule; any other
    worker pane that's up goes back to being a capsule."""
    view = rex_view(session)
    if view is None:
        return rex_focus(session, block)
    mine = {t["block"] for t in repo.tasks() if t.get("block")}
    target = find_pane(view, block=block)
    for w in view["windows"]:
        for layer in w.get("layers", []):
            if layer.get("kind") != "floating" or layer.get("state") == "minimized":
                continue
            if target and layer["layer_id"] == target[1]["layer_id"]:
                continue
            if any(b.get("block_id") in mine for b in layer.get("blocks", [])):
                set_layer(session, layer["layer_id"], "minimized")
    if target and target[1].get("kind") == "floating":
        if set_layer(session, target[1]["layer_id"], "normal", focus=True):
            return
    rex_focus(session, block)


ORDER = {"needs": 0, "stopped": 1, "ready": 2, "working": 3, "todo": 4, "done": 5, "dropped": 6}


def board_order(tasks):
    """Tasks as the board lists them: what needs you first, then by ID."""
    return sorted(tasks, key=lambda t: (ORDER.get(t["status"], 9), int(t["id"].rsplit("-", 1)[1])))


def ago(stamp, at=None):
    if not stamp:
        return ""
    at = at or dt.datetime.now().astimezone()
    s = max(0, int((at - dt.datetime.fromisoformat(stamp)).total_seconds()))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return "now"


def board_row(t, width, at=None):
    """One task's line: ID, status, time in that status, title, and why or PR."""
    extra = t.get("why") or pr_short(t.get("pr"))
    line = f"{t['id']:<7} {t['status']:<8} {ago(t.get('since') or t.get('updated'), at):>4}  {t['title']}"
    if extra:
        line += f"  · {extra}"
    return line[:max(0, width - 1)]


BOARD_HELP = [
    "enter go · c coordinator · n next needing you · p peek · t tell · s start · r resume · a all · q quit",
    "⏎ go · c coord · n next · p peek · t tell · s start · r resume · a all · q",
    "⏎ go · c · n · p · t · s · r · q",
]
STALE = 300  # seconds a task can need you before its age turns red


def seconds_in_status(t, at=None):
    stamp = t.get("since") or t.get("updated")
    if not stamp:
        return 0
    at = at or dt.datetime.now().astimezone()
    return (at - dt.datetime.fromisoformat(stamp)).total_seconds()


def cmd_board(args):
    import curses
    repo = Repo(repo_root())

    def bp(*a):
        p = run([SELF, *a], cwd=repo.root, check=False)
        return p.returncode == 0, (p.stdout if p.returncode == 0 else p.stderr).strip()

    def main(scr):
        curses.curs_set(0)
        # needs: yellow, turning red once it has waited STALE seconds
        colors = {"needs": 3, "stopped": 5, "ready": 2, "working": 6}
        try:
            curses.use_default_colors()
            for c in (*colors.values(), 1):
                curses.init_pair(c, c, -1)
        except curses.error:
            colors = {}
        scr.timeout(1000)
        sel, show_all, msg = None, False, ""
        while True:
            tasks = board_order(t for t in repo.tasks() if show_all or t["status"] not in CLOSED)
            ids = [t["id"] for t in tasks]
            if sel not in ids:
                sel = ids[0] if ids else None
            h, w = scr.getmaxyx()
            scr.erase()
            counts = {}
            for t in tasks:
                counts[t["status"]] = counts.get(t["status"], 0) + 1
            head = f" bullpen: {repo.root.name}  " + "  ".join(f"{n} {s}" for s, n in counts.items())
            scr.addnstr(0, 0, head, w - 1, curses.A_BOLD)
            if not tasks:
                scr.addnstr(2, 1, "no open tasks", w - 2, curses.A_DIM)
            for i, t in enumerate(tasks[: max(0, h - 4)]):
                attr = curses.color_pair(colors.get(t["status"], 0))
                if t["status"] in CLOSED:
                    attr |= curses.A_DIM
                if t["id"] == sel:
                    attr |= curses.A_REVERSE
                scr.addnstr(2 + i, 0, " " + board_row(t, w - 1), w - 1, attr)
                if t["status"] == "needs" and seconds_in_status(t) >= STALE and w > 23:
                    age = f"{ago(t.get('since') or t.get('updated')):>4}"
                    red = curses.color_pair(1) if colors else 0
                    scr.addnstr(2 + i, 18, age, 4, red | curses.A_BOLD | (attr & curses.A_REVERSE))
            if h > 3:
                scr.addnstr(h - 2, 0, " " + msg, w - 1, curses.A_BOLD)
                help_ = next((x for x in BOARD_HELP if len(x) < w - 1), BOARD_HELP[-1])
                scr.addnstr(h - 1, 0, " " + help_, w - 1, curses.A_DIM)
            scr.refresh()

            k = scr.getch()
            if k == -1:
                continue
            ch = chr(k) if 0 <= k < 256 else ""
            i = ids.index(sel) if sel in ids else 0
            msg = ""
            if ch == "q":
                return
            elif k in (curses.KEY_DOWN,) or ch == "j":
                sel = ids[min(i + 1, len(ids) - 1)] if ids else None
            elif k in (curses.KEY_UP,) or ch == "k":
                sel = ids[max(i - 1, 0)] if ids else None
            elif ch == "a":
                show_all = not show_all
            elif ch == "c":
                ok, msg = bp("go")
            elif ch == "n":
                needs = [t["id"] for t in tasks if t["status"] == "needs"]
                if needs:
                    after = [x for x in needs if ids.index(x) > i]
                    sel = (after or needs)[0]
                else:
                    msg = "nothing needs you"
            elif not sel:
                continue
            elif k in (10, 13, curses.KEY_ENTER) or ch == "g":
                ok, msg = bp("go", sel)
            elif ch == "s":
                ok, msg = bp("start", sel)
            elif ch == "r":
                ok, msg = bp("resume", sel)
            elif ch == "p":
                ok, out = bp("peek", sel, "--lines", str(max(1, h - 2)))
                scr.erase()
                scr.addnstr(0, 0, f" {sel} (any key returns)", w - 1, curses.A_BOLD)
                for j, line in enumerate(out.splitlines()[: h - 2]):
                    scr.addnstr(1 + j, 0, line, w - 1)
                scr.refresh()
                scr.timeout(-1)
                scr.getch()
                scr.timeout(1000)
            elif ch == "t":
                scr.addnstr(h - 2, 0, f" tell {sel}: ".ljust(w - 1), w - 1, curses.A_BOLD)
                curses.echo()
                curses.curs_set(1)
                scr.timeout(-1)
                text = scr.getstr(h - 2, len(f" tell {sel}: "), 500).decode(errors="replace").strip()
                scr.timeout(1000)
                curses.curs_set(0)
                curses.noecho()
                if text:
                    ok, msg = bp("tell", sel, text)
            msg = msg.splitlines()[-1] if msg else ""

    curses.wrapper(main)


def cmd_keys(args):
    keys = HOME / "lua" / "keys.lua"
    opts = f'bin = "{SELF}"'
    if os.environ.get("BULLPEN_STATE"):
        opts += f', state = "{STATE}"'
    print(f"-- Add to your Rex config (rex config shows where), then run `rex config reload`:\n"
          f'dofile("{keys}").setup{{ {opts} }}\n'
          f"-- Defaults: cmd+;>n next task needing you, cmd+;>b board, cmd+;>c coordinator.\n"
          f'-- Change them with prefix = "...", or keys = {{ next = ..., board = ..., coordinator = ... }}.')


# ---------- watcher events (called by lua/watch.lua) ----------

def cmd_event(args):
    repo, role = lookup_block(args.block)
    if not repo or role in ("coordinator", "board"):
        return
    t = repo.task(role)
    if t["block"] != args.block or t["status"] in CLOSED:
        return
    state, msg = args.state, (args.msg or "").strip()
    key = f"{state}|{msg}"
    if state == "working":
        if t["status"] in ("needs", "stopped"):
            t.update(status="working", why=None)
        t["last"] = key
        repo.save_task(t)
        return
    if key == t.get("last"):
        return
    t["last"] = key
    if state == "blocked":
        why = f"Needs you ({args.kind or 'input'})" + (f": {msg}" if msg else "")
        t.update(status="needs", why=why)
        repo.save_task(t)
        news(repo, t, "needs-you", f"{t['id']} {why[0].lower()}{why[1:]}")
    elif state == "error":
        t.update(status="needs", why="Failed" + (f": {msg}" if msg else ""))
        repo.save_task(t)
        news(repo, t, "failed", f"{t['id']} failed" + (f": {msg}" if msg else ""))
    elif state in ("done", "idle"):
        if t["status"] != "working":
            repo.save_task(t)
            return
        t.update(status="needs", why="Ended its turn without saying ready")
        repo.save_task(t)
        news(repo, t, "quiet", f"{t['id']} ended its turn without `ready`: read it with `bullpen peek {t['id']}`")
    else:
        repo.save_task(t)


def cmd_gone(args):
    repo, role = lookup_block(args.block)
    if not repo:
        return
    unindex_block(args.block)
    if role in ("coordinator", "board"):
        return
    t = repo.task(role)
    if t["block"] != args.block:
        return
    t["block"] = None
    if t["status"] in ("working", "needs"):
        t.update(status="stopped", why="Agent exited before saying ready")
        repo.save_task(t)
        news(repo, t, "stopped", f"{t['id']} stopped before saying ready: `bullpen resume {t['id']}` continues it")
    else:
        repo.save_task(t)


# ---------- main ----------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="bullpen", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("up", help="start (or register) this repo's coordinator and the watcher")
    p.add_argument("--here", action="store_true", help="make the agent in this pane the coordinator")
    p.add_argument("--session", help="Rex session (default: this pane's)")
    p.add_argument("--no-board", action="store_true", help="don't open the task board")
    p.set_defaults(fn=cmd_up)

    p = sub.add_parser("go", help="focus a task's pane (or the coordinator's, or the board's)")
    p.add_argument("id", nargs="?")
    p.add_argument("--next", action="store_true", help="the next task that needs you")
    p.add_argument("--board", action="store_true")
    p.add_argument("--from", dest="from_block", default=os.environ.get("REX_BLOCK"),
                   help="the pane you're in (default: this one)")
    p.add_argument("--session", help="the session you're in (key bindings pass it)")
    p.add_argument("--json", action="store_true", help="print the target instead of focusing it")
    p.set_defaults(fn=cmd_go)

    p = sub.add_parser("board", help="a live list of tasks to switch between")
    p.set_defaults(fn=cmd_board)

    p = sub.add_parser("keys", help="print the Rex config line for bullpen's key bindings")
    p.set_defaults(fn=cmd_keys)

    p = sub.add_parser("add", help="add a task; prints its ID")
    p.add_argument("title")
    p.add_argument("--brief")
    p.add_argument("--brief-file")
    p.add_argument("--base", help="branch to start from and open the PR against")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("start", help="make a task's worktree and start its worker")
    p.add_argument("id")
    p.add_argument("--session")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("resume", help="restart a stopped worker, continuing its conversation")
    p.add_argument("id")
    p.add_argument("message", nargs="?")
    p.add_argument("--session")
    p.set_defaults(fn=cmd_resume)

    p = sub.add_parser("tell", help="type a message to a task's worker")
    p.add_argument("id")
    p.add_argument("message", nargs="+")
    p.set_defaults(fn=cmd_tell)

    p = sub.add_parser("peek", help="print the end of a worker's screen")
    p.add_argument("id")
    p.add_argument("--lines", type=int, default=40)
    p.set_defaults(fn=cmd_peek)

    p = sub.add_parser("ready", help="(worker) push the branch, open the PR, tell the coordinator")
    p.add_argument("id")
    p.add_argument("--summary")
    p.add_argument("--summary-file")
    p.set_defaults(fn=cmd_ready)

    p = sub.add_parser("accept", help="(the person's call) merge a ready task's PR and clean up")
    p.add_argument("id")
    p.set_defaults(fn=cmd_accept)

    p = sub.add_parser("drop", help="stop a task, close its PR, remove its worktree")
    p.add_argument("id")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_drop)

    p = sub.add_parser("ls", help="list tasks")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_ls)

    p = sub.add_parser("show", help="one task")
    p.add_argument("id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("config", help="show or change this repo's settings")
    p.add_argument("--prefix")
    p.add_argument("--base")
    p.add_argument("--workers", choices=["float", "tabs"],
                   help="new workers as capsules in the coordinator's tab (float) or as tabs")
    p.set_defaults(fn=cmd_config)

    p = sub.add_parser("guide", help="print the coordinator's guide")
    p.set_defaults(fn=cmd_guide)

    p = sub.add_parser("_event")
    p.add_argument("block")
    p.add_argument("state")
    p.add_argument("kind", nargs="?")
    p.add_argument("msg", nargs="?")
    p.set_defaults(fn=cmd_event)

    p = sub.add_parser("_gone")
    p.add_argument("block")
    p.set_defaults(fn=cmd_gone)

    args = ap.parse_args(argv)
    try:
        args.fn(args)
    except Fail as e:
        print(f"bullpen: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
