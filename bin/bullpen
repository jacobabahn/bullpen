#!/bin/sh
# bullpen: runs the Rust build (target/bullpen), or says to build it. No forks on the
# usual path: the checkout is $0's, unless $0 is a link (install.sh's).
case $0 in */bin/bullpen) here=${0%/bin/bullpen} ;; *) here=/nowhere ;; esac
[ -f "$here/bin/bullpen-cargo" ] || here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
[ -x "$here/target/bullpen" ] && exec "$here/target/bullpen" "$@"
echo "bullpen: bullpen isn't built: run $here/install.sh (it needs cargo)" >&2
exit 1
