#!/usr/bin/env python3
"""bullpen: a coordinator and its worker agents, each in its own Rex pane.

Tasks live outside the repo, in $BULLPEN_STATE (default ~/.local/state/bullpen).
Each started task gets a git worktree, a branch and a Rex window running a
worker agent. A Lua watcher (lua/watch.lua, run with `rex do --all`) turns the
workers' program status into news lines typed into the coordinator's pane.
"""

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path(__file__).resolve().parent.parent
PROMPTS = HOME / "prompts"
WATCH_LUA = HOME / "lua" / "watch.lua"
STATE = Path(os.environ.get("BULLPEN_STATE") or Path.home() / ".local/state/bullpen")
REX = os.environ.get("BULLPEN_REX", "rex")
SELF = str(Path(__file__).resolve())

DEFAULT_CONFIG = {
    "prefix": "BP",
    "next": 1,
    "base": None,
    "worker": ["claude", "--permission-mode", "auto"],
    "coordinator_cmd": ["claude", "--permission-mode", "auto"],
    "coordinator": None,  # {"block": ..., "session": ...}
    "workers": "float",   # "float": minimized floating panes in the coordinator's tab; "tabs"
    "gh": None,           # the gh program, if not the one on PATH (BULLPEN_GH wins)
    "review": True,       # a reviewer agent checks each task before it's ready
    "review_rounds": 2,   # reviews before a task is ready anyway, findings listed
    "reviewer": ["claude", "--permission-mode", "auto"],
    "board_layout": "grouped",  # or "compact"
    "merge": "rebase",    # how accept merges a PR: rebase, squash or merge
}

TERMINAL = "com.superlogical.terminal.shell"
FLOAT_BOUNDS = [0.4, 0.35, 0.58, 0.62]  # bottom right of the window: x, y, w, h

CLOSED = ("done", "dropped")


class Fail(Exception):
    pass


# ---------- small helpers ----------

def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def run(cmd, cwd=None, check=True, input=None):
    # Never let a program read our terminal: from the board, it would wait there
    # for keys meant for the board.
    stdin = None if input is not None else subprocess.DEVNULL
    p = subprocess.run(cmd, cwd=cwd, input=input, stdin=stdin, text=True, capture_output=True)
    if check and p.returncode != 0:
        msg = (p.stderr or p.stdout).strip()
        raise Fail(f"`{' '.join(map(str, cmd))}` failed: {msg}")
    return p


def git(repo, *args, check=True):
    return run(["git", "-C", str(repo), *args], check=check)


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except FileNotFoundError:
        return default


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def safe(name):
    return re.sub(r"[^A-Za-z0-9._-]", "_", name)


def slug(title, n=40):
    s = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return s[:n].rstrip("-") or "task"


def resolve(cmd):
    """Absolute path for the program, so Rex panes don't depend on PATH."""
    exe = shutil.which(cmd[0])
    return [exe or cmd[0], *cmd[1:]]


# ---------- repo, config, tasks ----------

def repo_root(path=None):
    p = run(["git", "-C", str(path or os.getcwd()), "rev-parse", "--path-format=absolute",
             "--git-common-dir"], check=False)
    if p.returncode != 0:
        raise Fail("not in a git repository")
    common = Path(p.stdout.strip())
    return common.parent if common.name == ".git" else common


class Repo:
    def __init__(self, root):
        self.root = Path(root)
        self.dir = STATE / "repos" / safe(str(self.root).strip("/").replace("/", "-"))
        cfg = read_json(self.dir / "config.json", {})
        self.cfg = {**DEFAULT_CONFIG, **cfg}

    def save(self):
        self.cfg["root"] = str(self.root)
        write_json(self.dir / "config.json", self.cfg)

    def gh(self):
        return os.environ.get("BULLPEN_GH") or self.cfg.get("gh") or "gh"

    def base(self):
        if self.cfg.get("base"):
            return self.cfg["base"]
        p = git(self.root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False)
        if p.returncode == 0:
            return p.stdout.strip().split("/", 1)[1]
        return git(self.root, "branch", "--show-current").stdout.strip() or "main"

    def task_path(self, tid):
        return self.dir / "tasks" / f"{tid}.json"

    def task(self, tid):
        tid = self.norm(tid)
        t = read_json(self.task_path(tid))
        if t is None:
            raise Fail(f"no task {tid} in {self.root}")
        return t

    def norm(self, tid):
        tid = str(tid).upper()
        return tid if "-" in tid else f"{self.cfg['prefix']}-{tid}"

    def save_task(self, t):
        t["updated"] = now()
        old = read_json(self.task_path(t["id"])) or {}
        if old.get("status") != t["status"]:
            t["note"] = None  # what it needed then, not now
        if old.get("status") != t["status"] or not t.get("since"):
            # when it entered its current status; fine-grained so `go --next` can order it
            t["since"] = dt.datetime.now().astimezone().isoformat(timespec="microseconds")
        write_json(self.task_path(t["id"]), t)

    def tasks(self):
        d = self.dir / "tasks"
        out = [read_json(p) for p in d.glob("*.json")] if d.exists() else []
        return sorted(out, key=lambda t: int(t["id"].rsplit("-", 1)[1]))

    def worktree_dir(self, t):
        return self.root.parent / f"{self.root.name}-bullpen" / t["id"]


def index_block(block, repo, role):
    write_json(STATE / "blocks" / f"{safe(block)}.json", {"repo": str(repo.root), "role": role})


def unindex_block(block):
    if block:
        (STATE / "blocks" / f"{safe(block)}.json").unlink(missing_ok=True)


def lookup_block(block):
    entry = read_json(STATE / "blocks" / f"{safe(block)}.json") if block else None
    if not entry:
        return None, None
    return Repo(entry["repo"]), entry["role"]


def find_repo(from_block=None):
    """The repo a command is about: the one owning from_block, else the one we're in,
    else (for key bindings, which run in the Rex server's directory) the bullpen repo
    whose coordinator most recently started."""
    repo, _ = lookup_block(from_block)
    if repo:
        return repo
    try:
        repo = Repo(repo_root())
        if (repo.dir / "config.json").exists():
            return repo
    except Fail:
        pass
    best = None
    for cfg in (STATE / "repos").glob("*/config.json"):
        b = (read_json(cfg) or {}).get("coordinator")
        if not b:
            continue
        idx = STATE / "blocks" / f"{safe(b['block'])}.json"
        entry = read_json(idx)
        if entry and (best is None or idx.stat().st_mtime > best[0]):
            best = (idx.stat().st_mtime, entry["repo"])
    if best:
        return Repo(best[1])
    raise Fail("no bullpen here: run `bullpen up` in a repository first")


# ---------- Rex ----------

def with_state(argv):
    """Panes Rex starts don't inherit our environment: carry bullpen's own settings."""
    env = [f"{k}={os.environ[k]}" for k in ("BULLPEN_STATE", "BULLPEN_GH", "BULLPEN_REX")
           if os.environ.get(k)]
    return ["env", *env, *argv] if env else argv


def rex_run(session, cwd, label, argv, focus=False):
    cmd = [REX, "run", "--json", f"--focus={'true' if focus else 'false'}", "--label", label,
           "-c", str(cwd)]
    if session:
        cmd += ["-s", session]
    p = run([*cmd, "--", *with_state(argv)])
    return json.loads(p.stdout)["block_ids"][0]


def rex_alive(session, block):
    if not block:
        return False
    cmd = [REX, "block", "inspect", block] + (["-s", session] if session else [])
    return run(cmd, check=False).returncode == 0


def rex_type(session, block, text):
    """Type one line into a terminal and press Enter."""
    s = ["-s", session] if session else []
    run([REX, "send", *s, "-b", block, text])
    run([REX, "send-key", *s, "-b", block, "enter"])


def rex_focus(session, block):
    run([REX, "focus", *(["-s", session] if session else []), block])


def rex_api(session, method, args=None, check=True):
    """Call a Rex server API method; -s fills in session_id."""
    cmd = [REX, "api", "call", *(["-s", session] if session else []), method, json.dumps(args or {})]
    p = run(cmd, check=check)
    if p.returncode != 0 or not p.stdout.strip():
        return None
    return json.loads(p.stdout)


def rex_view(session):
    """The session's windows, layers and blocks, or None if Rex can't say."""
    v = rex_api(session, "session.view", check=False)
    return v if v and "windows" in v else None


def find_pane(view, block=None, label=None):
    """(window_id, layer, block_id) of a placed block, by ID, else by label."""
    for w in (view or {}).get("windows", []):
        for layer in w.get("layers", []):
            for b in layer.get("blocks", []):
                if (block and b.get("block_id") == block) or (not block and label and b.get("label") == label):
                    return w["window_id"], layer, b["block_id"]
    return None


def set_layer(session, layer_id, state, focus=False):
    args = {"layer_id": layer_id, "state": state}
    if focus:
        args["focus"] = True
    return rex_api(session, "session.set_layer_state", args, check=False) is not None


def rex_close(session, block):
    if block:
        run([REX, "block", "close", block] + (["-s", session] if session else []), check=False)


def pr_short(url):
    m = re.search(r"/pull/(\d+)", url or "")
    return f"PR #{m.group(1)}" if m else (url or "")


def news(repo, task, event, text):
    """Type one line of news into the coordinator's prompt: `bullpen · <what happened>`."""
    line = "bullpen · " + " ".join(text.split())  # one line: a newline would send it early
    log = repo.dir / "news.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a") as f:
        f.write(f"{now()} {task['id']} {event}: {line}\n")
    outbox = repo.dir / "outbox.txt"
    with outbox.open("a") as f:
        f.write(line + "\n")
    if not deliver(repo):
        (STATE / "outbox").touch()  # the watcher retries while this exists


def has_draft(session, block):
    """Is something half-typed in the coordinator's input? Typing news there would
    send it along. (Reads Claude Code's input box: the last line starting ❯.)"""
    p = run([REX, "capture", *(["-s", session] if session else []), "-b", block], check=False)
    lines = [l.strip() for l in p.stdout.splitlines() if l.strip()]
    for line in reversed(lines[-10:]):
        if line.startswith("❯"):
            return bool(line[1:].strip())
    return False


def deliver(repo):
    """Type the repo's waiting news into the coordinator, oldest first. False if it
    has to wait: no live coordinator, or the person is typing there."""
    outbox = repo.dir / "outbox.txt"
    lines = outbox.read_text().splitlines() if outbox.exists() else []
    if not lines:
        return True
    c = repo.cfg.get("coordinator") or {}
    if not rex_alive(c.get("session"), c.get("block")) or has_draft(c.get("session"), c["block"]):
        return False
    outbox.unlink()
    for line in lines:
        rex_type(c.get("session"), c["block"], line)
    return True


def cmd_flush(args):
    """(watcher) deliver news that had to wait."""
    waiting = False
    for cfg in (STATE / "repos").glob("*/outbox.txt"):
        repo = Repo(read_json(cfg.parent / "config.json", {}).get("root") or "/")
        repo.dir = cfg.parent
        repo.cfg = {**DEFAULT_CONFIG, **read_json(cfg.parent / "config.json", {})}
        if not deliver(repo):
            waiting = True
    if not waiting:
        (STATE / "outbox").unlink(missing_ok=True)


def coordinator_label(repo):
    return f"bullpen: {repo.root.name}"


def board_label(repo):
    return f"bullpen: {repo.root.name} board"


def session_for(repo, args=None):
    """The Rex session to work in: --session, else the coordinator's while it exists
    (a Rex restart gives sessions new IDs), else the one we're running in."""
    s = getattr(args, "session", None) if args else None
    c = (repo.cfg.get("coordinator") or {}).get("session")
    if s:
        return s
    if c and (c == os.environ.get("REX_SESSION") or rex_view(c) is not None):
        return c
    return os.environ.get("REX_SESSION") or c


# ---------- commands ----------

def cmd_up(args):
    repo = Repo(repo_root())
    session = session_for(repo, args)
    if not session:
        raise Fail("not inside Rex: pass --session")
    relink(repo, session)
    c = repo.cfg.get("coordinator")
    if args.here:
        block = os.environ.get("REX_BLOCK")
        if not block:
            raise Fail("--here needs REX_BLOCK (run it from the agent's own Rex pane)")
        if c:
            unindex_block(c.get("block"))
        repo.cfg["coordinator"] = {"block": block, "session": session}
        index_block(block, repo, "coordinator")
        print(f"coordinator: this pane ({block}). Run `{SELF} guide` to read the coordinator's guide.")
    elif c and rex_alive(c.get("session"), c.get("block")):
        print(f"coordinator already running: {c['block']}")
    else:
        argv = resolve(repo.cfg["coordinator_cmd"]) + [
            "-n", coordinator_label(repo),
            "--append-system-prompt-file", str(PROMPTS / "coordinator.md"),
            f"You are the bullpen coordinator for {repo.root}. The bullpen CLI is {SELF}. "
            f"Run `{SELF} ls`, then say in one short line that you are ready.",
        ]
        block = rex_run(session, repo.root, coordinator_label(repo), argv, focus=True)
        repo.cfg["coordinator"] = {"block": block, "session": session}
        index_block(block, repo, "coordinator")
        print(f"coordinator started: {block}")
    repo.save()
    if not args.no_board:
        ensure_board(repo, session)
    gather(repo, session)
    ensure_watcher(session)


def ensure_board(repo, session):
    """The task board, in a narrow pane to the right of the coordinator."""
    b = repo.cfg.get("board")
    if b and rex_alive(b.get("session"), b.get("block")):
        return
    c = repo.cfg["coordinator"]
    p = run([REX, "split", "--json", "--focus=false", "-s", session, "-b", c["block"],
             "--split=right", "--ratio", "35", "--label", board_label(repo),
             "-c", str(repo.root), "--", *with_state([SELF, "board"])])
    block = json.loads(p.stdout)["block_ids"][0]
    if b:
        unindex_block(b.get("block"))
    repo.cfg["board"] = {"block": block, "session": session}
    index_block(block, repo, "board")
    repo.save()
    print(f"board started: {block}")


def ensure_watcher(session):
    w = read_json(STATE / "watcher.json", {})
    if rex_alive(w.get("session"), w.get("block")):
        return
    argv = [shutil.which(REX) or REX, "do", "--all", str(WATCH_LUA),
            f"bin={SELF}", f"state={STATE}"]
    # Detached: it runs without a tab of its own.
    r = rex_api(session, "session.new_block", {
        "flavor": TERMINAL, "label": "bullpen: watcher",
        "options": {"command": with_state(argv), "cwd": str(Path.home())}})
    block = r["block_id"]
    write_json(STATE / "watcher.json", {"block": block, "session": session})
    print(f"watcher started: {block}")


def cmd_add(args):
    repo = Repo(repo_root())
    brief = Path(args.brief_file).read_text() if args.brief_file else args.brief
    if not brief:
        raise Fail("give the task's brief with --brief or --brief-file")
    tid = f"{repo.cfg['prefix']}-{repo.cfg['next']}"
    repo.cfg["next"] += 1
    repo.save()
    t = {"id": tid, "title": args.title, "status": "todo", "created": now(),
         "base": args.base or repo.base(), "branch": None, "worktree": None,
         "block": None, "session": None, "pr": None, "why": None, "last": None}
    (repo.dir / "briefs").mkdir(parents=True, exist_ok=True)
    (repo.dir / "briefs" / f"{tid}.md").write_text(brief.rstrip() + "\n")
    repo.save_task(t)
    print(tid)


def footer(repo, t):
    return (PROMPTS / "worker-footer.md").read_text().format(
        id=t["id"], title=t["title"], worktree=t["worktree"], branch=t["branch"],
        base=t["base"], bin=SELF)


def cmd_start(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if t["status"] not in ("todo", "stopped"):
        raise Fail(f"{t['id']} is {t['status']}; use `resume` or `tell`")
    session = session_for(repo, args)
    if not session:
        raise Fail("no Rex session: run `bullpen up` first or pass --session")
    if not t["worktree"]:
        base = t["base"]
        start_point = base
        if git(repo.root, "remote", "get-url", "origin", check=False).returncode == 0:
            git(repo.root, "fetch", "-q", "origin", base, check=False)
            if git(repo.root, "rev-parse", "-q", "--verify", f"origin/{base}", check=False).returncode == 0:
                start_point = f"origin/{base}"
        t["branch"] = f"bullpen/{t['id'].lower()}-{slug(t['title'])}"
        wt = repo.worktree_dir(t)
        wt.parent.mkdir(parents=True, exist_ok=True)
        git(repo.root, "worktree", "add", "-q", "--no-track", "-b", t["branch"], str(wt), start_point)
        t["worktree"] = str(wt)
    brief = (repo.dir / "briefs" / f"{t['id']}.md").read_text()
    full = repo.dir / "briefs" / f"{t['id']}.full.md"
    full.write_text(f"# {t['id']}: {t['title']}\n\n{brief}\n{footer(repo, t)}")
    first = f"You are the worker for bullpen task {t['id']}. Read your brief at {full} and follow it."
    launch(repo, t, session, first, resume=False)
    print(f"{t['id']} started in {t['worktree']} (branch {t['branch']}, pane {t['block']})")


def launch(repo, t, session, first, resume):
    argv = resolve(repo.cfg["worker"]) + (["--continue"] if resume else []) + \
        ["-n", f"{t['id']}: {t['title']}", first]
    unindex_block(t.get("block"))
    label = f"bullpen: {t['id']}"
    if repo.cfg.get("workers") == "tabs":
        block = rex_run(session, t["worktree"], label, argv)
    else:
        block = float_pane(repo, session, label, t["worktree"], argv)
    index_block(block, repo, t["id"])
    t.update(block=block, session=session, status="working", why=None, last=None)
    repo.save_task(t)


def float_pane(repo, session, label, cwd, argv):
    """Start argv in a minimized floating pane in the coordinator's window: it shows
    as a capsule at the bottom right until `bullpen go` brings it up."""
    args = {"bounds": FLOAT_BOUNDS, "layout": {"block": {
        "flavor": TERMINAL, "label": label,
        "options": {"command": with_state(argv), "cwd": str(cwd)}}}}
    c = repo.cfg.get("coordinator") or {}
    where = find_pane(rex_view(session), block=c.get("block"))
    if where:
        args["window_id"] = where[0]
    r = rex_api(session, "session.new_layer", args)
    set_layer(session, r["layer_id"], "minimized")
    return r["block_ids"][0]


def relink(repo, session):
    """A Rex restart brings panes back with new block IDs: find bullpen's own again
    by their labels. Panes that are gone are forgotten (a working task is stopped)."""
    view = rex_view(session)
    if view is None:
        return
    known = {}

    def ours(stored):
        """Is a pane recorded in session `stored` one to look for here? Yes if it's
        this session, or if that session no longer exists (a restart renamed it)."""
        if stored in (None, session, view.get("session_id"), view.get("label")):
            return True
        if stored not in known:
            known[stored] = rex_view(stored) is None
        return known[stored]

    for key, label in (("coordinator", coordinator_label(repo)), ("board", board_label(repo))):
        c = repo.cfg.get(key)
        if not c or (c.get("session") == session and find_pane(view, block=c.get("block"))):
            continue
        if find_pane(view, block=c.get("block")):
            c["session"] = session
            continue
        if not ours(c.get("session")):
            continue
        unindex_block(c.get("block"))
        hit = find_pane(view, label=label)
        repo.cfg[key] = {"block": hit[2], "session": session} if hit else None
        if hit:
            index_block(hit[2], repo, key)
            print(f"{key}: found again ({hit[2]})")
    repo.save()
    for t in repo.tasks():
        if t["status"] in CLOSED or not t.get("block") or find_pane(view, block=t["block"]):
            continue
        if not ours(t.get("session")):
            continue
        unindex_block(t["block"])
        hit = find_pane(view, label=f"bullpen: {t['id']}")
        if hit:
            t.update(block=hit[2], session=session)
            index_block(hit[2], repo, t["id"])
            print(f"{t['id']}: found again ({hit[2]})")
        else:
            t["block"] = None
            if t["status"] in ("working", "needs"):
                t.update(status="stopped", why="Its pane was gone")
        repo.save_task(t)
    relink_reviewers(repo, session, view)


def gather(repo, session):
    """Keep every worker and reviewer pane in the coordinator's tab, as capsules.
    A coordinator that was restarted opens in a new tab: move the panes there and
    close any tab that moving them left empty."""
    if repo.cfg.get("workers") == "tabs":
        return
    view = rex_view(session)
    c = repo.cfg.get("coordinator") or {}
    home = find_pane(view, block=c.get("block"))
    if not home:
        return
    emptied = set()
    for t in repo.tasks():
        if t["status"] in CLOSED:
            continue
        for b in (t.get("block"), (t.get("review") or {}).get("block")):
            where = find_pane(view, block=b) if b else None
            if not where or where[0] == home[0]:
                continue
            if rex_api(session, "session.move_block", {"block_id": b, "anchor_block_id": c["block"]},
                       check=False) is None:
                continue
            r = rex_api(session, "session.float_block", {"block_id": b, "bounds": FLOAT_BOUNDS}, check=False)
            if r:
                set_layer(session, r["layer_id"], "minimized")
            emptied.add(where[0])
    if emptied:
        for w in (rex_view(session) or {}).get("windows", []):
            if w["window_id"] in emptied and not any(l.get("blocks") for l in w.get("layers", [])):
                rex_api(session, "session.close_window", {"window_id": w["window_id"]}, check=False)


def relink_reviewers(repo, session, view):
    for t in repo.tasks():
        r = t.get("review") or {}
        if t["status"] in CLOSED or not r.get("block") or find_pane(view, block=r["block"]):
            continue
        unindex_block(r["block"])
        hit = find_pane(view, label=review_label(t))
        r.update(block=hit[2] if hit else None, session=session)
        if hit:
            index_block(hit[2], repo, f"{t['id']} review")
        repo.save_task(t)


def cmd_resume(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if rex_alive(t["session"], t["block"]):
        raise Fail(f"{t['id']}'s agent is still running; use `tell`")
    if not t["worktree"]:
        raise Fail(f"{t['id']} never started; use `start`")
    msg = args.message or "You were stopped before finishing. Check where you were and carry on with your brief."
    launch(repo, t, session_for(repo, args) or t["session"], msg, resume=True)
    print(f"{t['id']} resumed in pane {t['block']}")


def cmd_tell(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if not rex_alive(t["session"], t["block"]):
        raise Fail(f"{t['id']}'s agent isn't running; use `resume {t['id']} \"...\"`")
    rex_type(t["session"], t["block"], " ".join(args.message))
    if t["status"] in ("needs", "ready"):
        t.update(status="working", why=None, last=None)
        repo.save_task(t)
    print(f"sent to {t['id']}")


def cmd_peek(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if not rex_alive(t["session"], t["block"]):
        raise Fail(f"{t['id']}'s agent isn't running")
    s = ["-s", t["session"]] if t["session"] else []
    out = run([REX, "capture", *s, "-b", t["block"]]).stdout
    lines = [l for l in out.splitlines()]
    while lines and not lines[-1].strip():
        lines.pop()
    print("\n".join(lines[-args.lines:]))


def cmd_ready(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    wt = t["worktree"]
    if not wt:
        raise Fail(f"{t['id']} has no worktree")
    if git(wt, "status", "--porcelain").stdout.strip():
        raise Fail("uncommitted changes: commit (or discard) them, then run ready again")
    summary = Path(args.summary_file).read_text() if args.summary_file else (args.summary or "")
    base_ref = f"origin/{t['base']}" if git(wt, "rev-parse", "-q", "--verify", f"origin/{t['base']}", check=False).returncode == 0 else t["base"]
    ahead = int(git(wt, "rev-list", "--count", f"{base_ref}..HEAD").stdout.strip())
    if ahead == 0:
        t.update(status="ready", why="Nothing to merge (no commits)", summary=summary.strip() or None)
        repo.save_task(t)
        news(repo, t, "ready", f"{t['id']} is ready with nothing to merge: {t['title']}")
        print("no commits: marked ready with nothing to merge")
        return
    git(wt, "push", "-q", "--force-with-lease", "-u", "origin", f"HEAD:refs/heads/{t['branch']}")
    if not t.get("pr"):
        body = (summary.strip() or t["title"]) + f"\n\nBullpen task {t['id']}.\n"
        p = run([repo.gh(), "pr", "create", "--base", t["base"], "--head", t["branch"],
                 "--title", f"{t['title']} ({t['id']})", "--body-file", "-"], cwd=wt, input=body)
        t["pr"] = p.stdout.strip().splitlines()[-1]
    t.update(why=None, summary=summary.strip() or t.get("summary"), commits=ahead)
    if repo.cfg.get("review", True):
        start_review(repo, t, base_ref)
        print(f"pushed {t['branch']}; pull request: {t['pr']}. A reviewer checks it now: "
              f"end your turn, and you'll hear back if it asks for changes.")
        return
    t["status"] = "ready"
    repo.save_task(t)
    news(repo, t, "ready", f"{t['id']} is ready ({commits(ahead)}, {pr_short(t['pr'])}): {t['title']}")
    print(f"pushed {t['branch']}; pull request: {t['pr']}")


def commits(n):
    return f"{n} commit{'s' if n != 1 else ''}"


def review_label(t):
    return f"bullpen: {t['id']} review"


def start_review(repo, t, base_ref):
    """Start a reviewer agent on the task's branch, in its own capsule."""
    old = t.get("review") or {}
    close_reviewer(t)
    n = old.get("round", 0) + 1
    rounds = repo.cfg.get("review_rounds", 2)
    briefs = repo.dir / "briefs"
    prompt = briefs / f"{t['id']}.review-{n}.md"
    prompt.write_text((PROMPTS / "reviewer.md").read_text().format(
        id=t["id"], title=t["title"], round=n, rounds=rounds, brief=briefs / f"{t['id']}.md",
        worktree=t["worktree"], branch=t["branch"], base_ref=base_ref, bin=SELF,
        summary=t.get("summary") or "(none)"))
    first = f"You are the reviewer for bullpen task {t['id']}. Read {prompt} and follow it."
    argv = resolve(repo.cfg["reviewer"]) + ["-n", f"{t['id']} review", first]
    session = t.get("session") or session_for(repo)
    if repo.cfg.get("workers") == "tabs":
        block = rex_run(session, t["worktree"], review_label(t), argv)
    else:
        block = float_pane(repo, session, review_label(t), t["worktree"], argv)
    index_block(block, repo, f"{t['id']} review")
    t.update(status="review", why=None, review={
        "round": n, "block": block, "session": session, "verdict": None, "findings": None})
    repo.save_task(t)


def close_reviewer(t):
    r = t.get("review") or {}
    if r.get("block"):
        unindex_block(r["block"])
        rex_close(r.get("session"), r["block"])
        r["block"] = None


def cmd_verdict(args):
    """(reviewer) approve the task, or send findings back to its worker."""
    repo = Repo(repo_root())
    t = repo.task(args.id)
    r = t.get("review") or {}
    if t["status"] not in ("review", "needs") or not r.get("block"):
        raise Fail(f"{t['id']} isn't in review")
    text = (Path(args.summary_file).read_text() if args.summary_file else (args.summary or "")).strip()
    if not text:
        raise Fail("give your findings with --summary-file (or --summary)")
    findings = repo.dir / "briefs" / f"{t['id']}.review-{r['round']}.findings.md"
    findings.write_text(text + "\n")
    rounds = repo.cfg.get("review_rounds", 2)
    r.update(verdict="approved" if args.verdict == "approve" else "changes", findings=str(findings))
    reviewer = (r.get("session"), r.get("block"))
    unindex_block(r["block"])
    r["block"] = None
    pr = pr_short(t.get("pr"))
    if args.verdict == "approve":
        t.update(status="ready", why=None)
        repo.save_task(t)
        news(repo, t, "ready", f"{t['id']} is ready ({commits(t.get('commits') or 0)}, {pr}), "
             f"approved by review: {t['title']}")
    elif r["round"] < rounds:
        msg = (f"The reviewer asked for changes (review round {r['round']} of {rounds}). Read "
               f"{findings}, fix what you agree with, commit, and run your ready command again. "
               f"If you disagree with a finding, say why in your ready summary.")
        t.update(status="working", why=None, last=None)
        repo.save_task(t)
        if rex_alive(t.get("session"), t.get("block")):
            rex_type(t["session"], t["block"], msg)
        else:
            launch(repo, t, session_for(repo), msg, resume=True)
    else:
        t.update(status="ready", why=f"Review still asks for changes after {rounds} rounds")
        repo.save_task(t)
        news(repo, t, "ready", f"{t['id']} is ready ({pr}), but review still asks for changes "
             f"after {rounds} rounds: findings in {findings}: {t['title']}")
    print(f"verdict recorded: {args.verdict}")
    sys.stdout.flush()
    rex_close(*reviewer)  # last: this closes the pane we may be running in


def cmd_note(args):
    """Say on the board what a task needs, in a line (cleared when its status changes)."""
    repo = Repo(repo_root())
    t = repo.task(args.id)
    t["note"] = " ".join(" ".join(args.text).split())
    write_json(repo.task_path(t["id"]), t)  # not save_task: the status didn't change
    print(f"noted on {t['id']}")


def remove_worktree(repo, t, force=False):
    if t.get("worktree") and Path(t["worktree"]).exists():
        git(repo.root, "worktree", "remove", *(["--force"] if force else []), t["worktree"])
    if t.get("branch"):
        git(repo.root, "branch", "-D", t["branch"], check=False)


def cmd_accept(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if t["status"] != "ready":
        raise Fail(f"{t['id']} is {t['status']}, not ready")
    if t.get("pr"):
        p = run([repo.gh(), "pr", "merge", t["pr"], f"--{repo.cfg.get('merge', 'rebase')}"],
                cwd=repo.root, check=False)
        if p.returncode != 0:
            raise Fail(f"merge refused: {(p.stderr or p.stdout).strip()}")
        if t.get("branch"):
            git(repo.root, "push", "-q", "origin", "--delete", t["branch"], check=False)
    rex_close(t["session"], t["block"])
    unindex_block(t["block"])
    close_reviewer(t)
    remove_worktree(repo, t, force=True)
    t.update(status="done", block=None, worktree=None)
    repo.save_task(t)
    print(f"{t['id']} done" + (f" (merged {t['pr']})" if t.get("pr") else ""))


def cmd_drop(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if t.get("worktree") and Path(t["worktree"]).exists() and not args.force:
        if git(t["worktree"], "status", "--porcelain").stdout.strip():
            raise Fail(f"{t['id']} has uncommitted changes in {t['worktree']}; pass --force to discard them")
    rex_close(t["session"], t["block"])
    unindex_block(t["block"])
    close_reviewer(t)
    if t.get("pr"):
        run([repo.gh(), "pr", "close", t["pr"]], cwd=repo.root, check=False)
    remove_worktree(repo, t, force=args.force)
    t.update(status="dropped", block=None, worktree=None)
    repo.save_task(t)
    print(f"{t['id']} dropped")


def cmd_ls(args):
    repo = Repo(repo_root())
    tasks = [t for t in repo.tasks() if args.all or t["status"] not in CLOSED]
    if args.json:
        print(json.dumps(tasks, indent=2))
        return
    if not tasks:
        print("no open tasks" + ("" if args.all else " (--all shows finished ones)"))
    for t in tasks:
        extra = t.get("why") or t.get("pr") or ""
        print(f"{t['id']:<7} {t['status']:<8} {t['title']}" + (f"  ({extra})" if extra else ""))


def cmd_show(args):
    repo = Repo(repo_root())
    t = repo.task(args.id)
    if args.json:
        print(json.dumps(t, indent=2))
        return
    for k in ("id", "title", "status", "why", "note", "base", "branch", "worktree", "block", "pr", "summary"):
        if t.get(k):
            print(f"{k:>9}: {t[k]}")
    r = t.get("review") or {}
    if r:
        state = r.get("verdict") or "in progress"
        print(f"   review: round {r.get('round')}, {state}" + (f"; findings: {r['findings']}" if r.get("findings") else ""))
    print(f"    brief: {repo.dir / 'briefs' / (t['id'] + '.md')}")


def cmd_config(args):
    repo = Repo(repo_root())
    if args.prefix:
        if not re.fullmatch(r"[A-Z]{2,5}", args.prefix):
            raise Fail("prefix must be 2 to 5 capital letters")
        repo.cfg["prefix"] = args.prefix
    if args.base:
        repo.cfg["base"] = args.base
    if args.workers:
        repo.cfg["workers"] = args.workers
    if args.review:
        repo.cfg["review"] = args.review == "on"
    if args.merge:
        repo.cfg["merge"] = args.merge
    repo.save()
    print(json.dumps({"repo": str(repo.root), "state": str(repo.dir), **repo.cfg}, indent=2))


def cmd_guide(args):
    print((PROMPTS / "coordinator.md").read_text())


# ---------- getting around: go, board, keys ----------

def go_target(repo, args):
    """(session, block, name) of the pane `go` should focus."""
    if args.next:
        needs = sorted((t for t in repo.tasks() if t["status"] == "needs" and t.get("block")),
                       key=lambda t: t.get("since") or t.get("updated") or "")
        if not needs:
            raise Fail("nothing needs you")
        blocks = [t["block"] for t in needs]
        here = args.from_block
        t = needs[(blocks.index(here) + 1) % len(needs) if here in blocks else 0]
        return t["session"], t["block"], t["id"]
    if args.id and args.review:
        t = repo.task(args.id)
        r = t.get("review") or {}
        if not r.get("block"):
            raise Fail(f"{t['id']} has no reviewer running")
        return r.get("session") or t["session"], r["block"], f"{t['id']}'s reviewer"
    if args.id:
        t = repo.task(args.id)
        if not t.get("block"):
            hint = f"`bullpen resume {t['id']}`" if t["status"] == "stopped" else f"it is {t['status']}"
            raise Fail(f"{t['id']} has no pane ({hint})")
        return t["session"], t["block"], t["id"]
    which = "board" if args.board else "coordinator"
    c = repo.cfg.get(which)
    if not c:
        raise Fail(f"no {which}: run `bullpen up`")
    return c.get("session"), c["block"], which


def cmd_go(args):
    repo = find_repo(args.from_block)
    try:
        session, block, name = go_target(repo, args)
    except Fail as e:
        if not (args.next and str(e) == "nothing needs you" and (repo.cfg.get("board") or {}).get("block")):
            raise
        # A key that does nothing looks broken: show the board, where that's plain.
        print("bullpen: nothing needs you; showing the board", file=sys.stderr)
        args.next, args.board = False, True
        session, block, name = go_target(repo, args)
    if not rex_alive(session, block):
        # after a Rex restart its ID changed (and maybe its session's)
        relink(repo, args.session or os.environ.get("REX_SESSION") or session)
        repo = Repo(repo.root)
        session, block, name = go_target(repo, args)
        if not rex_alive(session, block):
            raise Fail(f"{name}'s pane is gone")
    if args.json:
        print(json.dumps({"session": session, "block": block, "name": name}))
    else:
        show_pane(repo, session, block)


def cmd_hide(args):
    """Put the worker or reviewer pane you're in back into its capsule and go back
    to the board. Exits 3 if that pane isn't one of bullpen's floating panes, so a
    key binding can let the key through."""
    repo, role = lookup_block(args.from_block)
    if not repo or role in ("coordinator", "board"):
        sys.exit(3)
    t = repo.task(role.split()[0])
    session = args.session or (t.get("review") or {}).get("session") or t.get("session")
    where = find_pane(rex_view(session), block=args.from_block)
    if not where or where[1].get("kind") != "floating":
        sys.exit(3)
    set_layer(session, where[1]["layer_id"], "minimized")
    for key in ("board", "coordinator"):
        c = repo.cfg.get(key) or {}
        if rex_alive(c.get("session"), c.get("block")):
            rex_focus(c.get("session"), c["block"])
            break


def show_pane(repo, session, block):
    """Focus a pane. A worker's floating pane comes up from its capsule; any other
    worker pane that's up goes back to being a capsule."""
    gather(repo, session)
    view = rex_view(session)
    if view is None:
        return rex_focus(session, block)
    mine = {b for t in repo.tasks() for b in (t.get("block"), (t.get("review") or {}).get("block")) if b}
    target = find_pane(view, block=block)
    for w in view["windows"]:
        for layer in w.get("layers", []):
            if layer.get("kind") != "floating" or layer.get("state") == "minimized":
                continue
            if target and layer["layer_id"] == target[1]["layer_id"]:
                continue
            if any(b.get("block_id") in mine for b in layer.get("blocks", [])):
                set_layer(session, layer["layer_id"], "minimized")
    if target and target[1].get("kind") == "floating":
        if set_layer(session, target[1]["layer_id"], "normal", focus=True):
            return
    rex_focus(session, block)


# The board groups tasks by what the person does next. Colour only marks status;
# the one loud thing is the amber bar beside a task that needs you.

GROUPS = [  # (heading, statuses), in the order the board shows them
    ("Needs you", ("needs", "stopped")),
    ("Ready to accept", ("ready",)),
    ("In review", ("review",)),
    ("Working", ("working",)),
    ("Queued", ("todo",)),
    ("Finished", ("done", "dropped")),
]
MARKS = {"needs": "●", "stopped": "■", "ready": "✓", "review": "◐", "working": "○",
         "todo": "·", "done": "✓", "dropped": "–"}
STALE = 300  # seconds a task can need you before its age turns red
MERGE_VERB = {"rebase": "rebase-merge", "squash": "squash-merge", "merge": "merge"}


def confirm_text(action, t, merge="rebase"):
    """The question a task's own row turns into while the board waits for y or n."""
    pr = pr_short(t.get("pr"))
    if action == "accept":
        return f"Accept and {MERGE_VERB.get(merge, merge)}?" if pr else "Accept and clean up?"
    if action == "drop":
        return f"Drop it and close {pr}?" if pr else "Drop it?"
    if action == "drop-force":
        return "Discard uncommitted changes?"
    return ""


def board_groups(tasks, finished=False):
    """[(heading, [tasks])] for the groups that have tasks, each sorted by ID."""
    out = []
    for heading, statuses in GROUPS:
        if heading == "Finished" and not finished:
            continue
        ts = sorted((t for t in tasks if t["status"] in statuses),
                    key=lambda t: int(t["id"].rsplit("-", 1)[1]))
        if ts:
            out.append((heading, ts))
    return out


def board_order(tasks, finished=True):
    return [t for _, ts in board_groups(tasks, finished) for t in ts]


def ago(stamp, at=None):
    if not stamp:
        return ""
    at = at or dt.datetime.now().astimezone()
    s = max(0, int((at - dt.datetime.fromisoformat(stamp)).total_seconds()))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return "now"


def seconds_in_status(t, at=None):
    stamp = t.get("since") or t.get("updated")
    if not stamp:
        return 0
    at = at or dt.datetime.now().astimezone()
    return (at - dt.datetime.fromisoformat(stamp)).total_seconds()


def task_detail(t, rounds=2):
    """What the task needs or where it stands, as a plain sentence."""
    st, r, pr = t["status"], t.get("review") or {}, pr_short(t.get("pr"))
    if t.get("note"):
        return t["note"]
    if st == "needs":
        why = t.get("why") or ""
        if why == "Ended its turn without saying ready":
            return "Stopped mid-task, probably with a question. p shows its screen."
        return why or "Waiting for you."
    if st == "stopped":
        return "Its agent exited. r resumes it."
    if st == "review":
        return f"Reviewer on round {r.get('round', 1)} of {rounds}."
    if st == "ready":
        if (t.get("why") or "").startswith("Nothing to merge"):
            return "Done, with nothing to merge."
        if r.get("verdict") == "approved":
            return f"{pr}, approved by review."
        if r.get("verdict") == "changes":
            return f"{pr}. Review still asks for changes."
        return f"{pr}." if pr else "Done."
    if st == "working" and r.get("verdict") == "changes":
        return f"Fixing what review round {r.get('round', 1)} found."
    if st == "todo":
        return "Not started. s starts it."
    if st == "done":
        return f"Accepted. {pr} merged." if pr else "Accepted."
    if st == "dropped":
        return "Dropped."
    return ""


def task_keys(t):
    """The keys that make sense for this task, for the footer."""
    return {
        "needs": "⏎ answer  t tell  p peek",
        "stopped": "r resume  p peek  d drop",
        "review": "⏎ reviewer  p peek",
        "ready": "a accept  d drop  ⏎ open",
        "working": "⏎ open  t tell  p peek",
        "todo": "s start  d drop",
    }.get(t["status"], "") if t else ""


def fit(text, width):
    """Cut text to width, with an ellipsis when it doesn't fit."""
    if width <= 0:
        return ""
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def wrap(text, width, lines):
    import textwrap
    out = textwrap.wrap(text, max(1, width)) or [""]
    if len(out) > lines:
        out = out[:lines]
        out[-1] = fit(out[-1] + " …", width) if len(out[-1]) + 2 > width else out[-1] + " …"
    return out


BOARD_KEYS = """\
Moving
  j k  ↑ ↓     select a task
  n            select the next task that needs you
  ⏎            open the worker's pane (the reviewer's, in review)
  c            back to the coordinator, panes put away

Acting on the selected task
  a            accept: merge its PR and clean up
  d            drop: close its PR, pane and worktree
  t            tell its worker something
  p            peek at the end of its worker's screen
  s            start it
  r            resume a stopped worker

The board
  l            switch layout (grouped, compact)
  f            show finished tasks too
  ?            this list
  q            quit the board
"""


def cmd_board(args):
    import curses
    root = repo_root()

    def bp(*a):
        p = run([SELF, *a], cwd=root, check=False)
        out = (p.stdout if p.returncode == 0 else p.stderr).strip()
        return p.returncode == 0, (out.splitlines() or [""])[-1].removeprefix("bullpen: ")

    def main(scr):
        curses.curs_set(0)
        # Escape also starts arrow-key sequences, so curses waits a second after it
        # by default. A terminal sends a sequence's bytes together: 25 ms is plenty.
        curses.set_escdelay(25)
        C = {}
        try:
            curses.use_default_colors()
            for name, n in (("amber", 3), ("green", 2), ("blue", 4), ("red", 1), ("magenta", 5)):
                curses.init_pair(n, n, -1)
                C[name] = curses.color_pair(n)
        except curses.error:
            pass
        col = lambda name: C.get(name, 0)
        mark_attr = {"needs": col("amber") | curses.A_BOLD, "stopped": col("red") | curses.A_BOLD,
                     "ready": col("green") | curses.A_BOLD, "review": col("blue") | curses.A_BOLD,
                     "working": curses.A_DIM, "todo": curses.A_DIM, "done": curses.A_DIM,
                     "dropped": curses.A_DIM}
        DIM, BOLD, REV = curses.A_DIM, curses.A_BOLD, curses.A_REVERSE

        scr.timeout(1000)
        sel, finished, msg, top = None, False, "", 0
        pending = None  # (action, task id): a y/n question shown on the task's row

        def put(y, x, text, attr=0):
            h, w = scr.getmaxyx()
            if 0 <= y < h and x < w - 1:
                try:
                    scr.addnstr(y, x, text, w - 1 - x, attr)
                except curses.error:
                    pass

        def busy(text):
            """Say what's happening on the message line before something slow."""
            h, w = scr.getmaxyx()
            scr.move(h - 1, 0)
            scr.clrtoeol()
            put(h - 1, 1, fit(text, w - 2), BOLD)
            scr.refresh()

        def prompt(label):
            h, w = scr.getmaxyx()
            scr.move(h - 1, 0)
            scr.clrtoeol()
            put(h - 1, 1, label, BOLD)
            curses.echo()
            curses.curs_set(1)
            scr.timeout(-1)
            try:
                text = scr.getstr(h - 1, min(len(label) + 2, w - 2), 500).decode(errors="replace").strip()
            except curses.error:
                text = ""
            scr.timeout(1000)
            curses.curs_set(0)
            curses.noecho()
            return text

        def overlay(title, lines):
            scr.erase()
            h, w = scr.getmaxyx()
            put(0, 1, fit(title, w - 2), BOLD)
            for j, line in enumerate(lines[: h - 3]):
                put(2 + j, 1, fit(line, w - 2))
            put(h - 1, 1, "any key returns", DIM)
            scr.refresh()
            scr.timeout(-1)
            scr.getch()
            scr.timeout(1000)

        while True:
            repo = Repo(root)
            layout = repo.cfg.get("board_layout", "grouped")
            rounds = repo.cfg.get("review_rounds", 2)
            tasks = repo.tasks()
            groups = board_groups(tasks, finished)
            order = [t for _, ts in groups for t in ts]
            ids = [t["id"] for t in order]
            if sel not in ids:
                sel = ids[0] if ids else None
            cur = next((t for t in order if t["id"] == sel), None)
            h, w = scr.getmaxyx()
            detail_w = lambda t: w - 5 - len(t["id"]) - 2  # under the title, to the right edge
            scr.erase()

            # header: the repository, and how many tasks are open
            n_open = sum(1 for t in tasks if t["status"] not in CLOSED)
            put(0, 1, fit(repo.root.name, w - 12), BOLD)
            count = f"{n_open} open" if n_open else ""
            put(0, max(1, w - 2 - len(count)), count, DIM)

            # rows: (kind, task, text) where kind is head, title, detail or gap
            rows = []
            for gi, (heading, ts) in enumerate(groups):
                if layout == "grouped":
                    if gi:
                        rows.append(("gap", None, ""))
                    rows.append(("head", None, f"{heading}  {len(ts)}"))
                elif gi:
                    rows.append(("gap", None, ""))
                for t in ts:
                    rows.append(("title", t, ""))
                    if layout == "grouped":
                        # what a task needs from you gets two lines; anything else one
                        lines = 2 if t["status"] in ("needs", "stopped") else 1
                        for d in wrap(task_detail(t, rounds), detail_w(t), lines):
                            if d:
                                rows.append(("detail", t, d))

            footer = 3 if layout == "grouped" else 7  # lines kept at the bottom
            avail = max(1, h - 3 - footer)  # one line spare for the scroll mark
            sel_rows = [i for i, r in enumerate(rows) if r[1] is cur and r[0] == "title"]
            if sel_rows:
                i = sel_rows[0]
                if i < top:
                    top = i - (1 if i and rows[i - 1][0] == "head" else 0)
                elif i + 1 >= top + avail:
                    top = i + 2 - avail
            top = max(0, min(top, max(0, len(rows) - avail)))
            while 0 < top < len(rows) and rows[top][0] in ("detail", "gap"):
                top += 1  # start at a heading or a task, never halfway through one
            if sel_rows and sel_rows[0] >= top + avail:
                top = sel_rows[0]

            if not tasks:
                put(2, 1, "No tasks yet.", BOLD)
                put(3, 1, fit("Tell the coordinator what you want done.", w - 2), DIM)
            y = 2
            for kind, t, text in rows[top: top + avail]:
                needs = t is not None and t["status"] in ("needs", "stopped")
                if needs and kind in ("title", "detail"):
                    put(y, 0, "▌", col("amber") if t["status"] == "needs" else col("red"))
                if kind == "head":
                    put(y, 1, text, BOLD)
                elif kind == "title":
                    selected = t is cur
                    age = ago(t.get("since") or t.get("updated"))
                    left = f"{t['id']}  "
                    width = w - 5  # from column 3 to the header's right edge
                    line = f"{left}{fit(t['title'], width - len(left) - len(age) - 2)}"
                    line = line.ljust(width - len(age)) + age
                    put(y, 1, MARKS.get(t["status"], " "), mark_attr.get(t["status"], 0))
                    if pending and pending[1] == t["id"]:
                        # the row becomes the question, in place: nothing below moves
                        tone = col("green") if pending[0] == "accept" else col("red")
                        q = confirm_text(pending[0], t, repo.cfg.get("merge", "rebase"))
                        yn = "y / n"
                        line = f"{left}{fit(q, width - len(left) - len(yn) - 2)}".ljust(width - len(yn)) + yn
                        put(y, 3, line, REV | BOLD | tone)
                        y += 1
                        continue
                    put(y, 3, line, (REV if selected else 0) | (DIM if t["status"] in CLOSED else 0))
                    put(y, 3, t["id"], (REV if selected else DIM))
                    if t["status"] == "needs" and seconds_in_status(t) >= STALE:
                        put(y, 3 + len(line) - len(age), age, col("red") | BOLD | (REV if selected else 0))
                    elif not selected:
                        put(y, 3 + len(line) - len(age), age, DIM)
                elif kind == "detail":
                    put(y, 3 + len(t["id"]) + 2, fit(text, detail_w(t)), DIM)

                y += 1
            if top + avail < len(rows):
                put(2 + avail, w - 3, "↓", DIM)
            if top:
                put(1, w - 3, "↑", DIM)

            # bottom: the compact layout's detail panel, a message line, the keys
            if layout == "compact" and cur:
                yb = h - footer
                put(yb, 1, "─" * (w - 3), DIM)
                put(yb + 1, 1, fit(f"{cur['id']}  {cur['title']}", w - 2), BOLD)
                for j, line in enumerate(wrap(task_detail(cur, rounds), w - 2, 3)):
                    put(yb + 2 + j, 1, line, DIM)
            if msg:
                put(h - 2, 1, fit(msg, w - 2), BOLD)
            if pending:
                verb = {"accept": "accept", "drop": "drop", "drop-force": "discard and drop"}[pending[0]]
                put(h - 1, 1, fit(f"y {verb}   any other key cancels", w - 2), BOLD)
            else:
                keys = task_keys(cur)
                keys = (keys + "   ? keys") if keys and len(keys) + 9 < w - 2 else (keys or "? keys")
                put(h - 1, 1, fit(keys, w - 2), DIM)
            scr.refresh()

            k = scr.getch()
            if k == -1:
                continue
            ch = chr(k) if 0 <= k < 256 else ""
            i = ids.index(sel) if sel in ids else 0
            msg = ""
            if pending:
                action, tid = pending
                pending = None
                if ch not in ("y", "Y"):
                    msg = "Cancelled."
                    continue
                if action == "accept":
                    busy(f"Accepting {tid}…")
                    ok, out = bp("accept", tid)
                    msg = f"Accepted {tid}." if ok else out
                else:
                    busy(f"Dropping {tid}…")
                    ok, out = bp("drop", tid, *(["--force"] if action == "drop-force" else []))
                    if not ok and "uncommitted" in out:
                        pending, msg = ("drop-force", tid), ""
                    else:
                        msg = f"Dropped {tid}." if ok else out
                continue
            if ch == "q":
                return
            elif k == curses.KEY_DOWN or ch == "j":
                sel = ids[min(i + 1, len(ids) - 1)] if ids else None
            elif k == curses.KEY_UP or ch == "k":
                sel = ids[max(i - 1, 0)] if ids else None
            elif ch == "?":
                overlay("Board keys", BOARD_KEYS.splitlines())
            elif ch == "l":
                repo.cfg["board_layout"] = "compact" if layout == "grouped" else "grouped"
                repo.save()
                top = 0
            elif ch == "f":
                finished = not finished
            elif ch == "c":
                ok, msg = bp("go")
            elif ch == "n":
                needs = [t["id"] for t in order if t["status"] in ("needs", "stopped")]
                after = [x for x in needs if ids.index(x) > i]
                if needs:
                    sel = (after or needs)[0]
                else:
                    msg = "Nothing needs you."
            elif not cur:
                continue
            elif k in (10, 13, curses.KEY_ENTER):
                if cur["status"] == "review" or (cur["status"] == "needs" and (cur.get("why") or "").startswith("Reviewer")):
                    ok, msg = bp("go", sel, "--review")
                elif cur.get("block"):
                    ok, msg = bp("go", sel)
                else:
                    msg = {"todo": "Not started yet: s starts it.", "stopped": "Its agent exited: r resumes it."}.get(
                        cur["status"], f"{sel} has no pane open.")
            elif ch == "a":
                if cur["status"] != "ready":
                    msg = f"Only a task that's ready to accept can be accepted."
                else:
                    pending = ("accept", sel)
            elif ch == "d":
                if cur["status"] in CLOSED:
                    continue
                pending = ("drop", sel)
            elif ch == "s":
                busy(f"Starting {sel}…")
                ok, out = bp("start", sel)
                msg = f"Started {sel}." if ok else out
            elif ch == "r":
                busy(f"Resuming {sel}…")
                ok, out = bp("resume", sel)
                msg = f"Resumed {sel}." if ok else out
            elif ch == "p":
                out = run([SELF, "peek", sel, "--lines", str(max(1, h - 4))], cwd=root, check=False)
                text = out.stdout if out.returncode == 0 else out.stderr
                overlay(f"{sel}  {cur['title']}", text.splitlines())
            elif ch == "t":
                text = prompt(f"Tell {sel}:")
                if text:
                    ok, out = bp("tell", sel, text)
                    msg = f"Sent to {sel}." if ok else out

    curses.wrapper(main)


def cmd_keys(args):
    keys = HOME / "lua" / "keys.lua"
    opts = f'bin = "{SELF}"'
    if os.environ.get("BULLPEN_STATE"):
        opts += f', state = "{STATE}"'
    print(f"-- Add to your Rex config (rex config shows where), then run `rex config reload`:\n"
          f'dofile("{keys}").setup{{ {opts} }}\n'
          f"-- Defaults: cmd+;>n next task needing you, cmd+;>b board, cmd+;>c coordinator,\n"
          f"-- and ctrl+escape puts the worker pane you're in back into its capsule.\n"
          f'-- Change them with prefix = "...", or keys = {{ next = ..., board = ..., coordinator = ..., hide = ... }}.')


# ---------- watcher events (called by lua/watch.lua) ----------

def cmd_event(args):
    repo, role = lookup_block(args.block)
    if not repo or role in ("coordinator", "board"):
        return
    if role.endswith(" review"):
        return review_event(repo, repo.task(role.split()[0]), args)
    t = repo.task(role)
    if t["block"] != args.block or t["status"] in CLOSED:
        return
    state, msg = args.state, (args.msg or "").strip()
    key = f"{state}|{msg}"
    if state == "working":
        if t["status"] in ("needs", "stopped"):
            t.update(status="working", why=None)
        t["last"] = key
        repo.save_task(t)
        return
    if key == t.get("last"):
        return
    t["last"] = key
    if state == "blocked":
        why = f"Needs you ({args.kind or 'input'})" + (f": {msg}" if msg else "")
        t.update(status="needs", why=why)
        repo.save_task(t)
        news(repo, t, "needs-you", f"{t['id']} {why[0].lower()}{why[1:]}")
    elif state == "error":
        t.update(status="needs", why="Failed" + (f": {msg}" if msg else ""))
        repo.save_task(t)
        news(repo, t, "failed", f"{t['id']} failed" + (f": {msg}" if msg else ""))
    elif state in ("done", "idle"):
        if t["status"] != "working":
            repo.save_task(t)
            return
        t.update(status="needs", why="Ended its turn without saying ready")
        repo.save_task(t)
        news(repo, t, "quiet", f"{t['id']} ended its turn without `ready`: read it with `bullpen peek {t['id']}`")
    else:
        repo.save_task(t)


def review_event(repo, t, args):
    """A reviewer's status: it only needs the person if it gets stuck."""
    r = t.get("review") or {}
    if r.get("block") != args.block or t["status"] not in ("review", "needs"):
        return
    state, msg = args.state, (args.msg or "").strip()
    stuck = t["status"] == "needs" and (t.get("why") or "").startswith("Reviewer")
    if state == "working":
        if stuck:
            t.update(status="review", why=None)
            repo.save_task(t)
    elif state == "blocked":
        why = f"Reviewer needs you ({args.kind or 'input'})" + (f": {msg}" if msg else "")
        t.update(status="needs", why=why)
        repo.save_task(t)
        news(repo, t, "needs-you", f"{t['id']}'s reviewer needs you ({args.kind or 'input'})" + (f": {msg}" if msg else ""))
    elif state in ("done", "idle", "error") and t["status"] == "review":
        t.update(status="needs", why="Reviewer stopped without a verdict")
        repo.save_task(t)
        news(repo, t, "quiet", f"{t['id']}'s reviewer stopped without a verdict: "
             f"`bullpen go {t['id']} --review` shows it")


def cmd_gone(args):
    repo, role = lookup_block(args.block)
    if not repo:
        return
    unindex_block(args.block)
    if role in ("coordinator", "board"):
        return
    if role.endswith(" review"):
        t = repo.task(role.split()[0])
        r = t.get("review") or {}
        if r.get("block") == args.block:
            r["block"] = None
            if t["status"] in ("review", "needs") and not r.get("verdict"):
                t.update(status="needs", why="Reviewer exited without a verdict")
                news(repo, t, "stopped", f"{t['id']}'s reviewer exited without a verdict")
            repo.save_task(t)
        return
    t = repo.task(role)
    if t["block"] != args.block:
        return
    t["block"] = None
    if t["status"] in ("working", "needs"):
        t.update(status="stopped", why="Agent exited before saying ready")
        repo.save_task(t)
        news(repo, t, "stopped", f"{t['id']} stopped before saying ready: `bullpen resume {t['id']}` continues it")
    else:
        repo.save_task(t)


# ---------- main ----------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="bullpen", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("up", help="start (or register) this repo's coordinator and the watcher")
    p.add_argument("--here", action="store_true", help="make the agent in this pane the coordinator")
    p.add_argument("--session", help="Rex session (default: this pane's)")
    p.add_argument("--no-board", action="store_true", help="don't open the task board")
    p.set_defaults(fn=cmd_up)

    p = sub.add_parser("go", help="focus a task's pane (or the coordinator's, or the board's)")
    p.add_argument("id", nargs="?")
    p.add_argument("--next", action="store_true", help="the next task that needs you")
    p.add_argument("--board", action="store_true")
    p.add_argument("--review", action="store_true", help="the task's reviewer, not its worker")
    p.add_argument("--from", dest="from_block", default=os.environ.get("REX_BLOCK"),
                   help="the pane you're in (default: this one)")
    p.add_argument("--session", help="the session you're in (key bindings pass it)")
    p.add_argument("--json", action="store_true", help="print the target instead of focusing it")
    p.set_defaults(fn=cmd_go)

    p = sub.add_parser("hide", help="put the worker pane you're in back into its capsule")
    p.add_argument("--from", dest="from_block", default=os.environ.get("REX_BLOCK"),
                   help="the pane to put away (default: this one)")
    p.add_argument("--session")
    p.set_defaults(fn=cmd_hide)

    p = sub.add_parser("board", help="a live list of tasks to switch between")
    p.set_defaults(fn=cmd_board)

    p = sub.add_parser("keys", help="print the Rex config line for bullpen's key bindings")
    p.set_defaults(fn=cmd_keys)

    p = sub.add_parser("add", help="add a task; prints its ID")
    p.add_argument("title")
    p.add_argument("--brief")
    p.add_argument("--brief-file")
    p.add_argument("--base", help="branch to start from and open the PR against")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("start", help="make a task's worktree and start its worker")
    p.add_argument("id")
    p.add_argument("--session")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("resume", help="restart a stopped worker, continuing its conversation")
    p.add_argument("id")
    p.add_argument("message", nargs="?")
    p.add_argument("--session")
    p.set_defaults(fn=cmd_resume)

    p = sub.add_parser("tell", help="type a message to a task's worker")
    p.add_argument("id")
    p.add_argument("message", nargs="+")
    p.set_defaults(fn=cmd_tell)

    p = sub.add_parser("peek", help="print the end of a worker's screen")
    p.add_argument("id")
    p.add_argument("--lines", type=int, default=40)
    p.set_defaults(fn=cmd_peek)

    p = sub.add_parser("ready", help="(worker) push the branch, open the PR, tell the coordinator")
    p.add_argument("id")
    p.add_argument("--summary")
    p.add_argument("--summary-file")
    p.set_defaults(fn=cmd_ready)

    p = sub.add_parser("verdict", help="(reviewer) approve a task or send it back with findings")
    p.add_argument("id")
    p.add_argument("verdict", choices=["approve", "changes"])
    p.add_argument("--summary")
    p.add_argument("--summary-file")
    p.set_defaults(fn=cmd_verdict)

    p = sub.add_parser("note", help="say on the board what a task needs, in one line")
    p.add_argument("id")
    p.add_argument("text", nargs="+")
    p.set_defaults(fn=cmd_note)

    p = sub.add_parser("accept", help="(the person's call) merge a ready task's PR (config --merge) and clean up")
    p.add_argument("id")
    p.set_defaults(fn=cmd_accept)

    p = sub.add_parser("drop", help="stop a task, close its PR, remove its worktree")
    p.add_argument("id")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_drop)

    p = sub.add_parser("ls", help="list tasks")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_ls)

    p = sub.add_parser("show", help="one task")
    p.add_argument("id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("config", help="show or change this repo's settings")
    p.add_argument("--prefix")
    p.add_argument("--base")
    p.add_argument("--workers", choices=["float", "tabs"],
                   help="new workers as capsules in the coordinator's tab (float) or as tabs")
    p.add_argument("--review", choices=["on", "off"], help="a reviewer agent checks each task")
    p.add_argument("--merge", choices=["rebase", "squash", "merge"], help="how accept merges a PR")
    p.set_defaults(fn=cmd_config)

    p = sub.add_parser("guide", help="print the coordinator's guide")
    p.set_defaults(fn=cmd_guide)

    p = sub.add_parser("_event")
    p.add_argument("block")
    p.add_argument("state")
    p.add_argument("kind", nargs="?")
    p.add_argument("msg", nargs="?")
    p.set_defaults(fn=cmd_event)

    p = sub.add_parser("_flush")
    p.set_defaults(fn=cmd_flush)

    p = sub.add_parser("_gone")
    p.add_argument("block")
    p.set_defaults(fn=cmd_gone)

    args = ap.parse_args(argv)
    try:
        args.fn(args)
    except Fail as e:
        print(f"bullpen: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
