#!/usr/bin/env python3
"""bullpen's entry script. The code is the bullpen package beside bin/ (bullpen/):
Python caches a package's bytecode, but compiles a script it runs on every call, so
this stays small. It finds the package from its own resolved path, so a link to it
(install.sh's) works too."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from bullpen.cli import main  # noqa: E402

sys.exit(main())
