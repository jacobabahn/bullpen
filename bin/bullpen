#!/bin/sh
# bullpen: the Rust build (target/bullpen); before the first build, the Python. No
# forks on the usual path: the checkout is $0's, unless $0 is a link (install.sh's).
case $0 in */bin/bullpen) here=${0%/bin/bullpen} ;; *) here=/nowhere ;; esac
[ -f "$here/bin/bullpen-py" ] || here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
[ -x "$here/target/bullpen" ] && exec "$here/target/bullpen" "$@"
exec python3 -S "$here/bin/bullpen-py" "$@"
