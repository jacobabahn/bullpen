#!/usr/bin/env -S python3 -S
"""bullpen's Python entry, which bin/bullpen's Rust build hands the commands Python
still owns (or bin/bullpen runs, before the first build). The code is the bullpen
package beside bin/ (bullpen/): Python caches a package's bytecode, but compiles a
script it runs on every call, so this stays small. It finds the package from its own
resolved path."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from bullpen.cli import main  # noqa: E402

sys.exit(main())
